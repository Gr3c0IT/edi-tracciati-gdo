# Connessione al database ARCA Evolution (SQL Server)
SERVER_DB=srv-db.example.local\SQLEXPRESS
DB_ARCA=ADB_ESEMPIO
# Credenziali SQL Server: lasciare vuoti DB_USER e DB_PASSWORD
# per usare l'autenticazione integrata di Windows
DB_USER=utente_sql_finto
DB_PASSWORD=password_finta

# Gmail API (invio dei tracciati): file OAuth scaricati da Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.pickle
